# Multi-stage Dockerfile for Angular App (Docker context: root repository or frontend/leave-management-ui)
FROM node:20-alpine AS build
WORKDIR /app

COPY frontend/leave-management-ui/package*.json ./
RUN npm ci

COPY frontend/leave-management-ui/ ./
RUN npm run build -- --configuration production

# Production Nginx Stage
FROM nginx:alpine
COPY --from=build /app/dist/leave-management-ui/browser /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
